# AI provider configuration
# Default remains OpenAI for convenience. First-class presets include OpenAI,
# Google Gemini, Anthropic Claude for chat, OpenRouter, Groq, Mistral,
# Together, DeepSeek, xAI, Ollama, and custom OpenAI-compatible endpoints.
LLM_PROVIDER=openai
LLM_API_KEY=your_chat_provider_api_key_here
LLM_MODEL=gpt-4o-mini
# Required for LLM_PROVIDER=openai-compatible or custom.
LLM_BASE_URL=

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_embedding_provider_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
# Required for EMBEDDING_PROVIDER=openai-compatible or custom.
EMBEDDING_BASE_URL=

# Backward-compatible shortcut. If LLM_API_KEY / EMBEDDING_API_KEY are empty,
# OPENAI_API_KEY is still accepted for OpenAI-backed chat and embeddings.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Authentication
APP_ENV=development
AUTH_SECRET_KEY=replace_with_a_long_random_secret
ADMIN_PASSWORD=replace_with_a_secure_admin_password
AUTH_TOKEN_TTL_MINUTES=480
# Separate secret used to encrypt admin-saved provider API keys at rest.
PROVIDER_SETTINGS_ENCRYPTION_KEY=replace_with_a_different_long_random_secret
# Keep false unless the app is reachable only through a trusted reverse proxy
# that strips client-supplied X-Forwarded-* headers.
TRUST_PROXY_HEADERS=false
# Optional production rate-limit backend. Leave empty for local single-instance demos.
REDIS_URL=
LOGIN_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_PER_MINUTE=20
FEEDBACK_RATE_LIMIT_PER_MINUTE=20
ADMIN_READ_RATE_LIMIT_PER_MINUTE=60
ADMIN_MUTATION_RATE_LIMIT_PER_MINUTE=20
DOCUMENT_UPLOAD_RATE_LIMIT_PER_HOUR=20
EVALUATION_RATE_LIMIT_PER_HOUR=10
OPTIMIZATION_RATE_LIMIT_PER_HOUR=5
MAX_TOP_K=20
MAX_OPTIMIZATION_CONFIGURATIONS=50

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://docuquery_user:docuquery_password@localhost:5433/docuquery
POSTGRES_USER=docuquery_user
POSTGRES_PASSWORD=docuquery_password
POSTGRES_DB=docuquery
POSTGRES_PORT=5433

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333

# Backend
BACKEND_PORT=8081
CORS_ORIGINS=http://localhost:5174

# Frontend
FRONTEND_PORT=5174
